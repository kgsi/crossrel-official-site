---
const { title, id, as: Component = 'section' } = Astro.props;
---

<Component
  class={`flex flex-col gap-6 md:px-[4rem] px-[2rem] md:py-[7rem] py-[4rem] max-w-[65em] ${Astro.props.class}`}
>
  {
    title && (
      <h2 id={id} class="w-fit px-2 py-1 bg-[black] text-[white] font-bold text-m">
        {title}
        <span aria-hidden>：</span>
      </h2>
    )
  }
  <slot />
</Component>
