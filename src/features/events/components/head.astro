---
import LogoImage from '../../../assets/img/logo/logo.svg';
---
<head>
  <meta charset="UTF-8">
  <title>イベント一覧 - CrossRel 交差するテックコミュニティ</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,200,0,200" />
  <meta property="og:title" content="イベント一覧 - CrossRel 交差するテックコミュニティ">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://crossrel.jp/events">
  <meta property="og:image" content="https://crossrel.jp/ogp.png">
  <meta property="og:site_name" content="CrossRel 交差するテックコミュニティ">
  <meta property="og:locale" content="ja_JP">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@crossrel_commu">
  <meta name="twitter:creator" content="@crossrel">
  <link rel="icon" href={LogoImage.src} type="image/x-icon">
</head>

