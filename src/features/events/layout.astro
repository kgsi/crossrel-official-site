---
import '../../assets/style.css';

import Logo from '../../components/logo.astro';

import Head from '../../components/Head.astro';
import Events from './components/events.astro';
import Footer from '../../components/footer.astro';
import FloatNavi from '../../components/float-navi.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { title, description, ogImage, canonicalUrl } = Astro.props as Props;
---

<!doctype html>
<html lang="ja">
  <Head title={title} description={description} ogImage={ogImage} canonicalUrl={canonicalUrl} />
  <body class="m-0 font-sans text-m flex flex-col">
    <header class="md:px-[4rem] px-[2rem] pt-[5rem]">
      <div class="h-[2.5rem] [&_img]:h-full">
        <a href="/"><Logo class="h-[2.5rem]" /></a>
      </div>
    </header>
    <FloatNavi />
    <Events />
    <Footer />
  </body>
</html>
