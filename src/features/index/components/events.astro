---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content'
import { dateFormatter } from '../../../libs/formatters/date'
import { targetFormatter } from '../../../libs/formatters/target'

import Section from '../../../components/section.astro'
import AnchorButton from '../../../components/anchor-button.astro'

const eventCollection= await getCollection('events')
const events = await Promise.all(eventCollection.map(async (event) => {
  const { Content } = await render(event)
  return { ...event, Content }
}))

---

<Section title="イベント" id="events">
  <div class="flex flex-col gap-12">
    <nav>
      <ol>
        {
          events.map((event) => (
          <li class="contents [&:not(:first-of-type)]:before:content-['/'] [&:not(:first-of-type)]:before:inline-block [&:not(:first-of-type)]:before:px-2">
            <a
              href="#"
              class="underline text-l"
            >{event.data.title}</a>
          </li>
          ))
        }
      </ol>
    </nav>
    <ol class="flex flex-col gap-[4.5rem]">
      {
        events.map((event) => (
          <li class="w-full flex flex-col gap-5">
            <Image src={event.data.thumbnail} alt="" class="max-h-[300px] w-fit " />
            <div class="flex flex-col gap-8">
              <div class="flex flex-col gap-0">
                <h3 class="text-xl font-bold">{event.data.title}</h3>
                <p>
                  開催日：
                  <time datetime={event.data.date}>{dateFormatter(event.data.date)}</time>
                </p>
                <p>対象：{targetFormatter(event.data.target)}</p>
              </div>
              <div class="flex flex-col gap-0">
                <event.Content />
              </div>
              <AnchorButton href={event.data.eventSiteURL}>
                イベントサイト
              </AnchorButton>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
