---
import { faChevronRight } from '@fortawesome/free-solid-svg-icons'
import Icon from '../../../components/icon.astro'
import Section from '../../../components/section.astro'

const itemClass = '[&:not(:first-of-type)]:ps-6 font-bold [&>a]:flex [&>a]:items-center'
---

<Section as="nav">
  <ul class="flex gap-6 p-1 flex-wrap divide-x-[1px] divide-[black]">
    <li class={itemClass}>
      <a href="#about">
        コミュニティについて
        <Icon type="material" icon="keyboard_arrow_down" class="text-[2rem]" />
      </a>
    </li>
    <li class={itemClass}>
      <a href="#events">
        イベント
        <Icon type="material" icon="keyboard_arrow_down" class="text-[2rem]" />
      </a>
    </li>
    <li class={itemClass}>
      <a href="#staff">
        スタッフ
        <Icon type="material" icon="keyboard_arrow_down" class="text-[2rem]" />
      </a>
    </li>
    <li class={itemClass}>
      <a href="#sponsors">
        スポンサー
        <Icon type="material" icon="keyboard_arrow_down" class="text-[2rem]" />
      </a>
    </li>
    <li class={itemClass}>
      <a href="#contact">
        お問い合わせ
        <Icon type="material" icon="keyboard_arrow_down" class="text-[2rem]" />
      </a>
    </li>
  </ul>
</Section>
