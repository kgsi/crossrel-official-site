---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import LumilinksLogo from '../../../assets/logo-lumilinks.svg';

import Section from '../../../components/section.astro';

const sponsors = await getCollection('sponsors');

// 会社名でソート
const sortedSponsors = sponsors.sort((a, b) => a.data.name.localeCompare(b.data.name, 'ja'));
---

<Section title="スポンサー" id="sponsors">
  <div class="flex flex-col gap-16">
    <div class="flex flex-col gap-6">
      <h3 class="text-m font-bold">過去の協賛スポンサー<span aria-hidden>：</span></h3>
      <div class="flex flex-wrap md:gap-x-6 gap-x-2 md:gap-y-2 gap-y-1">
        {
          sortedSponsors.map((sponsor) => (
            <a href={sponsor.data.url} target="_blank" rel="noopener noreferrer">
              <Image src={sponsor.data.thumbnail} alt={sponsor.data.name} height={100} />
            </a>
          ))
        }
      </div>
    </div>
    <div class="flex flex-col gap-6">
      <h3 class="text-m font-bold">運営<span aria-hidden>：</span></h3>
      <div class="p-4">
        <a href="https://lumilinks.jp/" target="_blank" rel="noopener noreferrer">
          <Image src={LumilinksLogo} height={40} alt="株式会社Lumilinks" />
        </a>
      </div>
    </div>
  </div>
</Section>
