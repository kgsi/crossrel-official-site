---
import { Image } from 'astro:assets'

import Section from '../../../components/section.astro'
---

<Section title="スポンサー" id="sponsors">
  <div class="flex flex-col gap-16">
    <div class="flex flex-col gap-4">
      <h3 class="text-[1rem] leading-[1.8] font-bold">オフィシャルスポンサー<span aria-hidden>：</span></h3>
      <!-- <Image src="" alt="" /> -->
    </div>
    <div class="flex flex-col gap-4">
      <h3 class="text-[1rem] leading-[1.8] font-bold">過去の協賛企業（順不同）<span aria-hidden>：</span></h3>
      <ul class="flex flex-col list-disc text-[1.25rem] leading-[1.5] ms-[1em] gap-2">
        <li>
          <a class="underline" href="https://example.com">株式会社サイバーエージェント</a>
        </li>
        <li>
          <a class="underline" href="https://example.com">株式会社マネーフォワード</a>
        </li>
      </ul>
    </div>
  </div>
</Section
