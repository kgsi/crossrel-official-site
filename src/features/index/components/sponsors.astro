---
import { Image } from 'astro:assets'

import Section from '../../../components/section.astro'
import Link from '../../../components/link.astro'
---

<Section title="スポンサー" id="sponsors">
  <div class="flex flex-col gap-16">
    <div class="flex flex-col gap-4">
      <h3 class="text-m font-bold">オフィシャルスポンサー<span aria-hidden>：</span></h3>
      <!-- <Image src="" alt="" /> -->
    </div>
    <div class="flex flex-col gap-4">
      <h3 class="text-m font-bold">過去の協賛企業（順不同）<span aria-hidden>：</span></h3>
      <ul class="flex flex-col list-disc text-l leading-tight  ms-[1em] gap-2">
        <li>
          <Link href="https://example.com" target="_blank">株式会社サイバーエージェント</Link>
        </li>
        <li>
          <Link href="https://example.com" target="_blank">株式会社マネーフォワード</Link>
        </li>
      </ul>
    </div>
  </div>
</Section
