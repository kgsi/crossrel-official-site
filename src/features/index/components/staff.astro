---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content'
import { dateFormatter } from '../../../libs/formatters/date'
import { targetFormatter } from '../../../libs/formatters/target'

import Section from '../../../components/section.astro'

const staffCollection = await getCollection('staff')
---

<Section title="スタッフ">
  <ul>
    {
      staffCollection.map((staff) => (
        <li class="flex flex-col gap-5">
          <Image src={staff.data.profile} alt="" class="max-h-[300px] w-fit " />
          <div class="flex flex-col gap-8">
            <div class="flex flex-col gap-0">
              <h3 class="text-[1.75rem] leading-[1.8] font-bold">{staff.data.name}</h3>
              <p>{staff.data.description}</p>
              <p>{staff.data.role}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
