---
import { getCollection } from 'astro:content';
import Section from '../../../components/section.astro';

const staffCollection = (await getCollection('staff')).toSorted((a, b) => {
  console.log(a, b);
  return a.data.number < b.data.number ? -1 : 1;
});
---

<Section title="Special Thanks" id="staff">
  <ul class="flex flex-wrap gap-1">
    {
      staffCollection.map((staff) => (
        <li class="gap-2 after:content-['/'] after:text-gray-500 after:ml-1 last:after:content-['']">
          <a
            class="underline underline-offset-[.3rem] hover:no-underline"
            href={`https://x.com/${staff.data.x}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {staff.data.name}
          </a>
        </li>
      ))
    }
  </ul>
</Section>
