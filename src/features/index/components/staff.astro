---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content'
import { faFacebook, faXTwitter } from '@fortawesome/free-brands-svg-icons'

import { dateFormatter } from '../../../libs/formatters/date'
import { targetFormatter } from '../../../libs/formatters/target'

import Section from '../../../components/section.astro'
import Icon from '../../../components/icon.astro'
import Link from '../../../components/icon.astro'

const staffCollection = await getCollection('staff')
---

<Section title="スタッフ" id="staff">
  <ul class="flex flex-wrap gap-8">
    {
      staffCollection.map((staff) => (
        <li class="flex flex-col gap-5">
          <Image src={staff.data.profile} alt="" class="max-h-[192px] w-fit " />
          <div class="flex flex-col gap-2">
            <h3 class="text-m leading-tighter font-bold">{staff.data.name}</h3>
            <div class="flex flex-col gap-4">
              <div class="hidden flex-col gap-1 text-s leading-tighter [&:has(>*:not(:empty))]:flex">
                <p class="empty:hidden">{staff.data.description}</p>
                <p class="empty:hidden">{staff.data.role}</p>
              </div>
              <div>
                <a href={`https://x.com/${staff.data.x}`}>
                  <Icon type="fa" icon={faXTwitter} />
                </a>
                <a href={`https://facebook.com/${staff.data.facebook}`}><Icon type="fa" icon={faFacebook} /></a>
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
