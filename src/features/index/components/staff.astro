---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { faFacebook, faXTwitter } from '@fortawesome/free-brands-svg-icons';

import Section from '../../../components/section.astro';
import Icon from '../../../components/icon.astro';

const staffCollection = (await getCollection('staff')).toSorted((a, b) => {
  console.log(a, b);
  return a.data.number < b.data.number ? -1 : 1;
});
---

<Section title="スタッフ" id="staff">
  <ul class="flex flex-wrap gap-8">
    {
      staffCollection.map((staff) => (
        <li class="flex md:flex-col gap-5 w-full md:w-[unset]">
          <Image
            src={staff.data.profile}
            alt=""
            class="flex-1 w-[50%] md:w-fit md:max-h-[10rem] md:max-w-[10rem] object-left object-contain"
          />
          <div class="flex flex-col gap-2 flex-1 min-w-[50%]">
            <h3 class="text-m leading-tighter font-bold">{staff.data.name}</h3>
            <div class="flex flex-col gap-4">
              <div class="hidden flex-col gap-1 text-s leading-tighter [&:has(>*:not(:empty))]:flex">
                <p class="empty:hidden">{staff.data.description}</p>
                <p class="empty:hidden">{staff.data.role}</p>
              </div>
              <div>
                <a href={`https://x.com/${staff.data.x}`}>
                  <Icon type="fa" icon={faXTwitter} alt="X" />
                </a>
                <a href={`https://facebook.com/${staff.data.facebook}`}>
                  <Icon type="fa" icon={faFacebook} alt="Facebook" />
                </a>
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
