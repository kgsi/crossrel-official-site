---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content'

import style from '../../assets/style.css'

import Navigation from './components/navigation.astro'
import Header from './components/header.astro'
import Head from './components/head.astro'
import About from './components/about.astro'
import Events from './components/events.astro'
import Staff from './components/staff.astro'
import Sponsors from './components/sponsors.astro'
import Contact from './components/contact.astro'
import Footer from './components/footer.astro'

import Event_R35 from '../../assets/img/events/r35/thumbnail.png'
import Event_Begin2025 from '../../assets/img/events/begin2025/thumbnail.png'
import Event_Bounen2024 from '../../assets/img/events/bounen2024/thumbnail.png'

import Event_Scene_Okane from '../../assets/img/events/okane/scene.jpg'
import Event_Scene_Pdm from '../../assets/img/events/pdm/scene.jpg'
import Event_Scene_Fintech from '../../assets/img/events/fintech/scene.jpg'

const events = await getCollection('events')
---

<!doctype html>
<html lang="ja">
  <Head />
  <body class="m-0 font-sans text-m flex flex-col">
    <Navigation />
    <Header />
    <About />
    <Events />
    <Staff />
    <Sponsors />
    <Contact />
    <Footer />
  </body>
</html>
