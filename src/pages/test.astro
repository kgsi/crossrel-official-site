---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'

const events = await getCollection('events')

console.log(events)
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title></title>
</head>
<body>
  {
    events.map((event) => (
      <div>
        <h2>{event.data.title}</h2>
        <p>{event.data.date}</p>
        <Image src={event.data.thumbnail} alt="event.data.title" />
      </div>
    ))
  }
</body>
</html>

